<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- ===================================================================
             Dark Theme (Carbon Deep / Sumi Inkwell)
             =================================================================== -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SurfaceColor">#FF0E0E10</Color>
            <SolidColorBrush x:Key="Surface"
                             Color="{StaticResource SurfaceColor}" />

            <Color x:Key="PrimaryColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="Primary"
                             Color="{StaticResource PrimaryColor}" />

            <Color x:Key="OnPrimaryColor">#FF1E1E22</Color>
            <SolidColorBrush x:Key="OnPrimary"
                             Color="{StaticResource OnPrimaryColor}" />

            <Color x:Key="SecondaryContainerColor">#FF2A2A30</Color>
            <SolidColorBrush x:Key="SecondaryContainer"
                             Color="{StaticResource SecondaryContainerColor}" />

            <Color x:Key="OnSecondaryContainerColor">#FFE2E2E6</Color>
            <SolidColorBrush x:Key="OnSecondaryContainer"
                             Color="{StaticResource
                             OnSecondaryContainerColor}" />

            <Color x:Key="OnSurfaceColor">#FFE2E2E6</Color>
            <SolidColorBrush x:Key="OnSurface"
                             Color="{StaticResource OnSurfaceColor}" />

            <Color x:Key="OnSurfaceVariantColor">#FF8E9099</Color>
            <SolidColorBrush x:Key="OnSurfaceVariant"
                             Color="{StaticResource OnSurfaceVariantColor}" />

            <Color x:Key="OutlineVariantColor">#FF2E2E34</Color>
            <SolidColorBrush x:Key="OutlineVariant"
                             Color="{StaticResource OutlineVariantColor}" />

            <Color x:Key="SurfaceContainerHighColor">#FF1E1E22</Color>
            <SolidColorBrush x:Key="SurfaceContainerHigh"
                             Color="{StaticResource SurfaceContainerHighColor}" />

            <Color x:Key="ErrorColor">#FFFFB4AB</Color>
            <SolidColorBrush x:Key="Error"
                             Color="{StaticResource ErrorColor
            }" />

            <Color x:Key="OnErrorColor">#FF690005</Color>
            <SolidColorBrush x:Key="OnError"
                             Color="{StaticResource OnErrorColor
            }" />

            <SolidColorBrush x:Key="OnSurface12"
                             Color="{StaticResource OnSurfaceColor}"
                             Opacity="0.12" />

            <SolidColorBrush x:Key="OnSurface38"
                             Color="{StaticResource OnSurfaceColor}"
                             Opacity="0.38" />
        </ResourceDictionary>
        <!-- ===================================================================
             Light Theme (Washi Paper Base / Sumi Ink)
             =================================================================== -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SurfaceColor">#FFF9F9FB</Color>
            <SolidColorBrush x:Key="Surface"
                             Color="{StaticResource SurfaceColor}" />

            <Color x:Key="PrimaryColor">#FF121214</Color>
            <SolidColorBrush x:Key="Primary"
                             Color="{StaticResource PrimaryColor}" />

            <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="OnPrimary"
                             Color="{StaticResource OnPrimaryColor}" />

            <Color x:Key="SecondaryContainerColor">#FFE4E4E8</Color>
            <SolidColorBrush x:Key="SecondaryContainer"
                             Color="{StaticResource SecondaryContainerColor}" />

            <Color x:Key="OnSecondaryContainerColor">#FF121214</Color>
            <SolidColorBrush x:Key="OnSecondaryContainer"
                             Color="{StaticResource OnSecondaryContainerColor}" />

            <Color x:Key="OnSurfaceColor">#FF1A1C1D</Color>
            <SolidColorBrush x:Key="OnSurface"
                             Color="{StaticResource OnSurfaceColor}" />

            <Color x:Key="OnSurfaceVariantColor">#FF74777F</Color>
            <SolidColorBrush x:Key="OnSurfaceVariant"
                             Color="{StaticResource OnSurfaceVariantColor}" />

            <Color x:Key="OutlineVariantColor">#FFE2E2E6</Color>
            <SolidColorBrush x:Key="OutlineVariant"
                             Color="{StaticResource OutlineVariantColor}" />

            <Color x:Key="SurfaceContainerHighColor">#FFE8E8EA</Color>
            <SolidColorBrush x:Key="SurfaceContainerHigh"
                             Color="{StaticResource SurfaceContainerHighColor}" />

            <Color x:Key="ErrorColor">#FFBA1A1A</Color>
            <SolidColorBrush x:Key="Error"
                             Color="{StaticResource ErrorColor}" />

            <Color x:Key="OnErrorColor">#FFFFFFFF</Color>
            <SolidColorBrush x:Key="OnError"
                             Color="{StaticResource OnErrorColor}" />

            <SolidColorBrush x:Key="OnSurface12"
                             Color="{StaticResource OnSurfaceColor}"
                             Opacity="0.12" />

            <SolidColorBrush x:Key="OnSurface38"
                             Color="{StaticResource OnSurfaceColor}"
                             Opacity="0.38" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ===================================================================
         Shape Tokens (M3 Corner Radii Scale)
         =================================================================== -->
    <CornerRadius x:Key="ShapeCornerSmall">8</CornerRadius>
    <CornerRadius x:Key="ShapeCornerMedium">16</CornerRadius>
    <CornerRadius x:Key="ShapeCornerFull">9999</CornerRadius>

    <!-- ===================================================================
         Spacing & Dimension Tokens
         =================================================================== -->
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">16</x:Double>

    <!-- ===================================================================
         Opacity Tokens
         =================================================================== -->
    <x:Double x:Key="StateHoverOpacity">0.08</x:Double>
    <x:Double x:Key="StatePressedOpacity">0.12</x:Double>
</ResourceDictionary>
