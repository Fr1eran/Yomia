<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yomia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Yomia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Yomia">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="80,*">
        <Border Grid.Column="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource OutlineVariant}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="0,16">

                <StackPanel DockPanel.Dock="Top" Spacing="16" HorizontalAlignment="Center">

                    <Button Classes="icon" ToolTip.Tip="Open comic file">
                        <PathIcon Data="{StaticResource Icon_FileOpen}" />
                    </Button>

                    <Border Height="1" Width="32" Background="{DynamicResource OutlineVariant}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Classes="icon" ToolTip.Tip="Settings">
                        <PathIcon Data="{StaticResource Icon_Settings}" />
                    </Button>
                </StackPanel>

                <ListBox DockPanel.Dock="Top"
                         Margin="0,12"
                         Theme="{DynamicResource NavigationRailTheme}"
                         SelectedIndex="0">
                    <ListBoxItem ToolTip.Tip="Library">
                        <PathIcon Data="{StaticResource Icon_Library}" />
                    </ListBoxItem>
                    <ListBoxItem ToolTip.Tip="Bookmark">
                        <PathIcon Data="{StaticResource Icon_Bookmark}" />
                    </ListBoxItem>
                    <ListBoxItem ToolTip.Tip="History">
                        <PathIcon Data="{StaticResource Icon_History}" />
                    </ListBoxItem>
                </ListBox>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <TextBlock Text="Yomia Comic Reader Content Area"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OnSurface}" />
        </Grid>
    </Grid>

</Window>
