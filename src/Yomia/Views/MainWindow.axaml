<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yomia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Yomia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Yomia"
        Width="900" Height="640"
        MinWidth="640" MinHeight="420">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="80,*">
        <Border Grid.Column="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource OutlineVariant}"
                BorderThickness="0,0,1,0">
            <!-- The star row bounds scrolling while short navigation lists remain bottom-aligned. -->
            <Grid RowDefinitions="Auto,*" Margin="0,16">

                <Button Grid.Row="0"
                        AutomationProperties.Name="Open File"
                        HorizontalAlignment="Center"
                        Width="48"
                        Height="48"
                        CornerRadius="16"
                        Background="{DynamicResource SecondaryContainer}"
                        Foreground="{DynamicResource OnSecondaryContainer}"
                        Padding="0">
                    <PathIcon Data="{StaticResource IconFileOpen}" Width="20" Height="20"/>
                </Button>

                <ListBox Grid.Row="1"
                         VerticalAlignment="Bottom"
                         Classes="NavigationRail"
                         Theme="{StaticResource NavigationRailTheme}"
                         SelectedIndex="0">

                    <ListBoxItem Tag="Library" AutomationProperties.Name="Library">
                        <Panel>
                            <PathIcon Classes="RailIconNormal" Data="{StaticResource IconLibrary}"/>
                            <PathIcon Classes="RailIconSelected" Data="{StaticResource IconLibraryFilled}"/>
                        </Panel>
                    </ListBoxItem>

                    <ListBoxItem Tag="Bookmark" AutomationProperties.Name="Bookmark">
                        <Panel>
                            <PathIcon Classes="RailIconNormal" Data="{StaticResource IconBookmark}" />
                            <PathIcon Classes="RailIconSelected" Data="{StaticResource IconBookmarkFilled}" />
                        </Panel>
                    </ListBoxItem>

                    <ListBoxItem Tag="History" AutomationProperties.Name="History">
                        <PathIcon Data="{StaticResource IconHistory}" />
                    </ListBoxItem>

                    <ListBoxItem Tag="Settings" AutomationProperties.Name="Settings">
                        <Panel>
                            <PathIcon Classes="RailIconNormal" Data="{StaticResource IconSettings}" />
                            <PathIcon Classes="RailIconSelected" Data="{StaticResource IconSettingsFilled}" />
                        </Panel>
                    </ListBoxItem>
                </ListBox>

            </Grid>
        </Border>

        <TextBlock Grid.Column="1"
                   Text="Yomia Comic Reader Content Area"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource OnSurface}"
                   Margin="24" />
    </Grid>

</Window>
